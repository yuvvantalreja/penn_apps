# Simple CAD Assembly - Multiple Components
# Component 1: Base Plate (rectangular base)
# Component 2: Cylinder (shaft/rod)
# Component 3: Gear (hexagonal gear)
# Component 4: Small Cube (connector/joint)

# Base Plate - Component 1 (centered at origin, flat)
# Bottom face
v -2.0 -0.1 -1.0
v  2.0 -0.1 -1.0
v  2.0 -0.1  1.0
v -2.0 -0.1  1.0
# Top face
v -2.0  0.1 -1.0
v  2.0  0.1 -1.0
v  2.0  0.1  1.0
v -2.0  0.1  1.0

# Cylinder - Component 2 (vertical shaft)
# Bottom circle (8 vertices)
v  0.3  0.1  0.0
v  0.212 0.1  0.212
v  0.0  0.1  0.3
v -0.212 0.1  0.212
v -0.3  0.1  0.0
v -0.212 0.1 -0.212
v  0.0  0.1 -0.3
v  0.212 0.1 -0.212
# Top circle (8 vertices)
v  0.3  1.5  0.0
v  0.212 1.5  0.212
v  0.0  1.5  0.3
v -0.212 1.5  0.212
v -0.3  1.5  0.0
v -0.212 1.5 -0.212
v  0.0  1.5 -0.3
v  0.212 1.5 -0.212

# Hexagonal Gear - Component 3 (at top of cylinder)
# Bottom hexagon
v  0.6  1.5  0.0
v  0.3  1.5  0.52
v -0.3  1.5  0.52
v -0.6  1.5  0.0
v -0.3  1.5 -0.52
v  0.3  1.5 -0.52
# Top hexagon
v  0.6  1.8  0.0
v  0.3  1.8  0.52
v -0.3  1.8  0.52
v -0.6  1.8  0.0
v -0.3  1.8 -0.52
v  0.3  1.8 -0.52

# Small Cube - Component 4 (connector at side)
v  1.5 0.5 -0.2
v  1.8 0.5 -0.2
v  1.8 0.5  0.2
v  1.5 0.5  0.2
v  1.5 0.8 -0.2
v  1.8 0.8 -0.2
v  1.8 0.8  0.2
v  1.5 0.8  0.2

# Faces for Base Plate (Component 1)
g base_plate
# Bottom face
f 1 2 3 4
# Top face
f 8 7 6 5
# Side faces
f 1 5 6 2
f 2 6 7 3
f 3 7 8 4
f 4 8 5 1

# Faces for Cylinder (Component 2)
g cylinder
# Bottom face (fan triangulation)
f 9 10 11
f 9 11 12
f 9 12 13
f 9 13 14
f 9 14 15
f 9 15 16
f 9 16 10
# Top face (fan triangulation)
f 17 19 18
f 17 20 19
f 17 21 20
f 17 22 21
f 17 23 22
f 17 24 23
f 17 18 24
# Side faces (cylinder wall)
f 9 10 18 17
f 10 11 19 18
f 11 12 20 19
f 12 13 21 20
f 13 14 22 21
f 14 15 23 22
f 15 16 24 23
f 16 9 17 24

# Faces for Hexagonal Gear (Component 3)
g gear
# Bottom face
f 25 26 27 28 29 30
# Top face
f 36 35 34 33 32 31
# Side faces
f 25 31 32 26
f 26 32 33 27
f 27 33 34 28
f 28 34 35 29
f 29 35 36 30
f 30 36 31 25

# Faces for Small Cube (Component 4)
g connector
# Bottom face
f 37 38 39 40
# Top face
f 44 43 42 41
# Side faces
f 37 41 42 38
f 38 42 43 39
f 39 43 44 40
f 40 44 41 37
